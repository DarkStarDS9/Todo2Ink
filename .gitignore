# Xcode / XcodeGen
# The .xcodeproj is generated from project.yml — never committed, except the shared
# Package.resolved beneath it, which pins the resolved SwiftPM dependency versions (including
# CompanionKit's protocol-version-tracking major) and must be committed for reproducible builds.
# A trailing-slash pattern (e.g. `*.xcodeproj/`) makes git skip the directory's contents
# entirely, so a `!` re-include of anything nested inside it is a no-op; each level below has to
# be excluded with `dir/*` (not `dir/`) instead, so git still descends into it to see the next
# level's rules.
Todo2Ink.xcodeproj/*
!Todo2Ink.xcodeproj/project.xcworkspace
Todo2Ink.xcodeproj/project.xcworkspace/*
!Todo2Ink.xcodeproj/project.xcworkspace/xcshareddata
Todo2Ink.xcodeproj/project.xcworkspace/xcshareddata/*
!Todo2Ink.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
DerivedData/
build/
*.xcuserstate
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Fastlane / signing artefacts
*.mobileprovision
*.p12
*.ipa
*.dSYM.zip

# Real signing/account identifiers (team id, ASC key id/issuer, export options)
# are personal to this Apple Developer account and never committed. Templates with placeholder
# values are committed instead (Local.xcconfig.example, ExportOptions.plist.example).
Todo2Ink/Configs/Local.xcconfig
ExportOptions.plist
docs/testflight.local.md
.env

# Generated by XcodeGen from project.yml, like the .xcodeproj itself.
Todo2Ink/Info.plist

# Claude Code worktree-bridge sessions and the prune hook's state file.
.claude/worktrees/
.claude/hooks/.known-orphans
